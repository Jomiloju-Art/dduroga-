{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/products/g65tdl",
      "destination": "/products/g63tdl",
      "permanent": true
    },
    {
      "source": "/products/nif-techo-fl-30-copy",
      "destination": "/products/vp49tl",
      "permanent": true
    },
    {
      "source": "/products/proclo-n382-copy",
      "destination": "/products/proclo-m382",
      "permanent": true
    },
    {
      "source": "/products/proclo-21",
      "destination": "/products/proclo-m592",
      "permanent": true
    },
    {
      "source": "/products/proclo-11",
      "destination": "/products/proclo-n382",
      "permanent": true
    },
    {
      "source": "/products/selkrik-rex",
      "destination": "/products/selkirk-rex",
      "permanent": true
    },
    {
      "source": "/products/doxle-gold-copy",
      "destination": "/products/doxle",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/products",
      "has": [
        {
          "type": "query",
          "key": "range",
          "value": "(?<v>[a-z0-9-]+)"
        }
      ],
      "destination": "/_p/products-range/:v.html"
    },
    {
      "source": "/products",
      "has": [
        {
          "type": "query",
          "key": "industry",
          "value": "(?<v>[a-z0-9-]+)"
        }
      ],
      "destination": "/_p/products-industry/:v.html"
    },
    {
      "source": "/products",
      "has": [
        {
          "type": "query",
          "key": "cat",
          "value": "(?<v>[a-z0-9-]+)"
        }
      ],
      "destination": "/_p/products-cat/:v.html"
    },
    {
      "source": "/products/:slug",
      "destination": "/_p/products/:slug.html"
    },
    {
      "source": "/learning/:slug",
      "destination": "/_p/learning/:slug.html"
    },
    {
      "source": "/:page(products|about|learning|contact|certifications|search|quote)",
      "destination": "/_p/:page.html"
    }
  ],
  "headers": [
    {
      "source": "/_p/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(png|jpg|jpeg|webp|svg|ico|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
